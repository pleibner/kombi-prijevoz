# Copy to .env for local development (npm run dev, npm run build).
# The live site does not read this file: the GitHub Actions deploy builds with the repository
# variables of the same names (Settings → Secrets and variables → Actions → Variables).

# EmailJS (https://dashboard.emailjs.com), used by the contact form on /kontakt.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# Account → General → Public Key
VITE_EMAILJS_PUBLIC_KEY=
# Inbox that receives the contact form requests, passed to the template as send_to.
VITE_AUTOMATIC_EMAIL_RECEIVER=

# Analytics events (tracking-service). Keep it off locally so tests don't pollute the stats.
VITE_TRACKING_SERVICE_URL=https://tracking-service-gamma.vercel.app/api/track
VITE_TRACKING_ENABLED=false
